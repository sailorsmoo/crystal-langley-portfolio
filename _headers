# Password protection — HTTP Basic Auth, scoped per case study.
# Netlify reads this file from the publish directory root and applies these
# headers to matching paths. Format: username:password (space-separated pairs
# if you want more than one login per project).
#
# IMPORTANT — CHANGE EVERY PASSWORD BELOW BEFORE GOING LIVE.
# These are placeholders. If this repo is public on GitHub, anyone can read
# this file, so don't leave real passwords in git history either — rotate
# them here, or move to a private repo / Netlify environment-variable-backed
# auth (an Edge Function) if these need to stay confidential long-term.

/sommsation
  Basic-Auth: crystal:CHANGE_ME_sommsation
/sommsation/*
  Basic-Auth: crystal:CHANGE_ME_sommsation

/strivers
  Basic-Auth: crystal:CHANGE_ME_strivers
/strivers/*
  Basic-Auth: crystal:CHANGE_ME_strivers

/sequoia-benefits
